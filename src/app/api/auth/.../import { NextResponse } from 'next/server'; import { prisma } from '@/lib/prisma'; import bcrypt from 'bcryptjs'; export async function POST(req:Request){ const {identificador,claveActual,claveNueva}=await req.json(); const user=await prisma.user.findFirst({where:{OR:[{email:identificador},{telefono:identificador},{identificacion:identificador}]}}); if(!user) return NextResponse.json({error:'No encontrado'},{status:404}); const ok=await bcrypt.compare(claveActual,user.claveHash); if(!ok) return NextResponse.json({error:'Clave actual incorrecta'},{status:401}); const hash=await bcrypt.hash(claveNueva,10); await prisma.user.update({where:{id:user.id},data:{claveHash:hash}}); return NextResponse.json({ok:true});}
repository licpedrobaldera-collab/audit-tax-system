import { NextResponse } from 'next/server'; import { prisma } from '@/lib/prisma'; import bcrypt from 'bcryptjs'; export async function POST(req:Request){ const {identificador,claveActual,claveNueva}=await req.json(); const user=await prisma.user.findFirst({where:{OR:[{email:identificador},{telefono:identificador},{identificacion:identificador}]}}); if(!user) return NextResponse.json({error:'No encontrado'},{status:404}); const ok=await bcrypt.compare(claveActual,user.claveHash); if(!ok) return NextResponse.json({error:'Clave actual incorrecta'},{status:401}); const hash=await bcrypt.hash(claveNueva,10); await prisma.user.update({where:{id:user.id},data:{claveHash:hash}}); return NextResponse.json({ok:true});}
